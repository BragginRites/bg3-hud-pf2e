<section class="pf2e bg3-tt-card">
    <section class="bg3-tt-header">
        <div class="bg3-tt-top">
            <img class="bg3-tt-portrait" src="{{ img }}" alt="{{ name }}">
            <div class="bg3-tt-name">
                <span class="bg3-tt-title">{{ name }}</span>
                <span class="bg3-tt-subtitle">{{ subtitle }}</span>
            </div>
        </div>
    </section>
    {{#if actionCostLabel}}
    <div class="bg3-tt-tags">
        <span class="bg3-tt-tag bg3-tt-action">{{ actionCostLabel }}</span>
    </div>
    {{/if}}
    {{#if traits}}
    <div class="bg3-tt-tags">
        {{#each traits}}
        <span class="bg3-tt-tag bg3-tt-trait">{{ this }}</span>
        {{/each}}
    </div>
    {{/if}}
    {{#if isSpell}}
    <div class="bg3-tt-spell">
        {{#if level}}
        <span class="bg3-tt-spell-level">Level {{ level }}</span>
        {{/if}}
        {{#if school}}
        <span class="bg3-tt-spell-school">{{ school }}</span>
        {{/if}}
        {{#if traditions}}
        <span class="bg3-tt-spell-traditions">{{ traditions }}</span>
        {{/if}}
    </div>
    {{/if}}
    <section class="bg3-tt-description">{{{ description }}}</section>
</section>
